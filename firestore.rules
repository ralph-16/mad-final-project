rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: readable by any signed-in student. Created in the
    // Firebase console (in-app creation is out of scope).
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Registrations: a student can only touch their own docs, and the
    // doc ID must equal studentId_eventId (duplicate guard).
    // get allows resource == null so the duplicate-check read of a
    // not-yet-created doc is permitted; list stays owner-only per doc.
    match /registrations/{registrationId} {
      allow get: if request.auth != null
        && (resource == null || resource.data.studentId == request.auth.uid);

      allow list: if request.auth != null
        && resource.data.studentId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && registrationId == request.resource.data.studentId + '_' + request.resource.data.eventId
        && request.resource.data.status == 'registered';

      allow delete: if request.auth != null
        && resource.data.studentId == request.auth.uid;

      allow update: if false;
    }
  }
}
